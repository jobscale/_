{
  "name": "cdk-app",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "watch": "echo \"No watch configured for JavaScript ESM\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage --collectCoverage --verbose",
    "lint": "eslint",
    "predeploy": "npm run lint",
    "synth": "ENV=${ENV:-dev} && cdk synth --all --context env=$ENV",
    "diff": "ENV=${ENV:-dev} && cdk diff --all --context env=$ENV",
    "deploy": "ENV=${ENV:-dev} && cdk deploy --all --context env=$ENV",
    "ls": "ENV=${ENV:-dev} && cdk ls --all --context env=$ENV"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@jobscale/eslint-plugin-standard": "^0.1.1",
    "aws-cdk": "^2.1135.1",
    "eslint-plugin-jest": "^29.16.0",
    "jest": "^30.4.2"
  }
}
