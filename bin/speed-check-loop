#!/usr/bin/env bash
set -eu

loop() {
  while (SOUND=~/_/mp3/alert.mp3 speedtest); do
    nmcli connection show --active | grep wifi
    loop.js 300 -s
  done
}

broken() {
  echo
  loop.js 50 -s
  echo "$(TZ=Asia/Tokyo date -Iseconds) $(get-ip | xargs)"
  echo
  loop.js 120 -s
}

while loop; do
  broken
done
