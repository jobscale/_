{
  "manifest_version": 3,
  "name": "Cloud Microsoft CSP Strip",
  "version": "1.0.0",
  "description": "Remove CSP headers from cloud.microsoft responses.",
  "icons": {
    "16": "favicon.png",
    "32": "favicon.png",
    "48": "favicon.png",
    "128": "favicon.png"
  },
  "content_scripts": [{
    "matches": ["*://*/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }, {
    "matches": ["*://*/*"],
    "js": ["world-main.js"],
    "run_at": "document_start",
    "world": "MAIN"
  }],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://192.168.0.1/*",
    "http://172.16.6.1/*",
    "*://*.cloud.microsoft/*",
    "*://*.microsoft.com/*",
    "*://*.office.com/*",
    "*://*.microsoftonline.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "csp_rules",
      "enabled": true,
      "path": "rules.json"
    }]
  }
}
